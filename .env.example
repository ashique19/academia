APP_NAME="Academia Training Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Indexing. Production hosts (academiatraining.eu, www.academiatraining.eu)
# stay indexable regardless of APP_ENV. Hosts starting with "x." — including
# x.academiatraining.eu — are always noindex,nofollow, even if APP_ENV is
# production. Other hosts are indexable only when APP_ENV=production.
# SEO_PRODUCTION_HOSTS adds extra always-indexable hosts (comma-separated).
# SEO_STAGING_HOSTS adds extra never-indexable hosts.
SEO_PRODUCTION_HOSTS=
SEO_STAGING_HOSTS=x.academiatraining.eu

# Public-facing defaults
ACADEMIA_LEGAL_ENTITY="SlimCijfers Analytics B.V."
ACADEMIA_TRADE_NAME="Academia Training Solutions"
ACADEMIA_EMAIL=info@academiatraining.eu
ACADEMIA_PHONE="+31 20 000 0000"

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Database
#
# SQLite is the default so the project runs immediately after clone with
# no service to install. PostgreSQL is the production recommendation
# (spec §2.2) — swap the block below. Every migration is written to work
# on both; Postgres-only features (tsvector, partial indexes) are applied
# conditionally in the migrations themselves.
# ---------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=academia
# DB_USERNAME=academia
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis in production (cache, queue, session)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@academiatraining.eu"
MAIL_FROM_NAME="${APP_NAME}"

# Lead routing
ACADEMIA_SALES_EMAIL=sales@academiatraining.eu
ACADEMIA_SLA_HOURS=2

# Consent wording version — bump whenever the consent text changes, so the
# stored proof records what the user actually agreed to (spec §22.1).
ACADEMIA_CONSENT_VERSION=2026-08-v1

# Verified reviews. Until BOTH are set, no rating renders anywhere and
# aggregateRating schema is suppressed (spec §3.1).
ACADEMIA_REVIEW_SCORE=
ACADEMIA_REVIEW_COUNT=
