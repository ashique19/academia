{
    "name": "slimcijfers/academia-training",
    "type": "project",
    "description": "Academia Training Solutions \u2014 European professional training academy platform.",
    "keywords": [
        "laravel",
        "livewire",
        "training",
        "edtech"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0",
        "laravel/framework": "^12.0",
        "league/csv": "^9.16",
        "livewire/livewire": "^3.5",
        "maatwebsite/excel": "^3.1",
        "spatie/laravel-activitylog": "^4.9",
        "spatie/laravel-backup": "^9.1",
        "spatie/laravel-medialibrary": "^11.9",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-sitemap": "^7.2",
        "spatie/laravel-sluggable": "^3.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.17",
        "laravel/sail": "^1.31",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "setup": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate:fresh --seed --ansi",
            "@php artisan academia:import --ansi",
            "@php artisan db:seed --class=PostImportSeeder --ansi"
        ],
        "test": "@php artisan test",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
